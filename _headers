# Cache policy (RT-PERF-2): HTML/JS/CSS entry points stay no-store so version
# bumps propagate instantly. Fingerprinted asset bytes (?v= on EVERY ref,
# enforced by gate Check 11) are immutable for a year. If you change an asset
# file's bytes, you MUST bump its ?v= or clients will keep the old bytes.
# Specific rules first (first match wins on Cloudflare Pages).
/game/assets/*
  Cache-Control: public, max-age=31536000, immutable

/game/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/video-demo/*
  Cache-Control: public, max-age=31536000, immutable

/video-intro/*
  Cache-Control: public, max-age=31536000, immutable

/character-sprites/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Cache-Control: public, max-age=31536000, immutable
